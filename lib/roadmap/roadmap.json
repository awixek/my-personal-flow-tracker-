      "source_key": "iitm-coursework",
      "title": "IITM Coursework",
      "schedule_type": "daily",
      "sub_tasks": [
        { "source_key": "video-content", "title": "Watch/complete week's video content", "sequence": 0, "planned_minutes": 40 },
        { "source_key": "assignment", "title": "Solve graded assignment", "sequence": 1, "planned_minutes": 35 },
        { "source_key": "quiz-prep", "title": "Quiz/end-term prep block", "sequence": 2, "planned_minutes": 20, "active_only_if": "exam_week" }
      ],
      "notes": "Base daily total 75 min (within the 60-90 min range). During a flagged exam_week, quiz-prep appends as a 3rd linear sub-task, bringing the day to 95 min."
    },
    {
